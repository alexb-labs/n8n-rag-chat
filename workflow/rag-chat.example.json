    {
      "parameters": {
        "jsCode": "const systemPrompt = `\nYou are a helpful assistant. Use the supplied past context only when it is relevant to the current request. If the available context is insufficient, say so rather than inventing details.\n`;\n\n//\n// 1. Get chronological messages\n//\nlet chronological = $items(\"Load Chat History\").map(i => i.json);\n\n// Sort to oldest → newest\nchronological.sort((a, b) => new Date(a.created_at) - new Date(b.created_at));\n\n//\n// 2. Get semantic messages\n//\nlet semantic = $items(\"Semantic Recall\").map(i => i.json);\n\n//\n// 2a. Exclude the latest user message from semantic messages\n//\n//const latestUserContent = $node[\"New Message\"].json.chatInput;\n//semantic = semantic.filter(\n//  m => !(m.role === \"user\" && m.content === latestUserContent)\n//);\n\n//\n// 3. Remove semantic messages that already exist in chronological\n//\nconst chronoSet = new Set(\n  chronological.map(m => m.role + \"|\" + m.content)\n);\n\nsemantic = semantic.filter(\n  m => !chronoSet.has(m.role + \"|\" + m.content)\n);\n\n//\n// 4. Sort semantic by created_at (oldest first for stability)\n//\nsemantic.sort((a, b) => new Date(a.created_at) - new Date(b.created_at));\n\n//\n// 5. Deduplicate semantic + chronological internally\n//\nconst unique = new Map();\n[...semantic, ...chronological].forEach(msg => {\n  const key = msg.role + \"|\" + msg.content;\n  if (!unique.has(key)) unique.set(key, msg);\n});\n\n//\n// 6. Final message array: system prompt → semantic → chronological\n//\nconst messages = [\n  { role: \"system\", content: systemPrompt },\n\n  { role: \"system\", content: \"Relevant past context:\" },\n  ...semantic.map(m => ({ role: m.role, content: m.content })),\n\n  { role: \"system\", content: \"Current conversation:\" },\n  ...chronological.map(m => ({ role: m.role, content: m.content }))\n];\n\nreturn [{ json: { messages } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        16,
        160
      ],
      "id": "821cb1bf-6116-4bd4-96e8-57c5a2fc4d49",
      "name": "System Prompt + Array"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO messages (thread_id, role, content, embedding)\nVALUES ($1::uuid, $2, $3, $4::vector);",
        "options": {
          "queryReplacement": "={{ [\n  $node[\"Fetch Thread ID\"].json[\"id\"],\n  \"assistant\",\n  $node[\"Openrouter Chat\"].json.choices[0].message.content,\n$json.skipEmbedding\n      ? null\n      : $node[\"Embed Assistant\"].json.data[0].embedding\n] }}"
        }
      },

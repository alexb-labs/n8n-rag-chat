      "id": "3d90bf94-b2bd-4a4a-8a15-c73bc58653b4",
      "name": "Embed User"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH scored AS (\n  SELECT\n    role,\n    content,\n    created_at,\n\n    -- cosine similarity\n    1 - (embedding <=> $2::vector) AS similarity,\n\n    -- recency decay (30 day window)\n    GREATEST(\n      0,\n      1 - (EXTRACT(EPOCH FROM (NOW() - created_at)) / (60*60*24*30))\n    ) AS recency_score\n\n  FROM messages\n  WHERE thread_id = $1::uuid\n    AND content <> $3\n  AND embedding IS NOT NULL\n)\n\nSELECT\n  role,\n  content,\n  created_at\nFROM scored\nWHERE similarity >= 0.65\nORDER BY (similarity + (0.15 * recency_score)) DESC\nLIMIT 4;",
        "options": {
          "queryReplacement": "={{ [\n  $node[\"Fetch Thread ID\"].json[\"id\"],\n  JSON.stringify($node[\"Embed User\"].json[\"data\"][0][\"embedding\"]),\n  $node[\"New Message\"].json.chatInput\n] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1120,
        -112
      ],
      "id": "874511c9-186a-42dd-9388-f925574f4543",
      "name": "Semantic Recall",
      "alwaysOutputData": true

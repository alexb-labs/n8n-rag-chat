      "id": "94fdbc2f-f640-4f37-8f10-ecd26befd2c1",
      "name": "Embed Assistant"
    },
    {
      "parameters": {
        "jsCode": "const raw = $node[\"New Message\"].json.chatInput || \"\";\nconst content = raw.trim().toLowerCase();\n\nconst ignorePhrases = [\n  \"thanks\",\n  \"thank you\",\n  \"ok\",\n  \"okay\",\n  \"sounds good\",\n  \"great\",\n  \"perfect\",\n  \"got it\",\n  \"understood\",\n  \"cool\",\n  \"nice\",\n  \"alright\",\n  \"makes sense\"\n];\n\nconst wordCount = content.split(/\\s+/).filter(Boolean).length;\nconst charCount = content.length;\n\nconst isGeneric = ignorePhrases.includes(content);\n\nconst shouldStore =\n  charCount >= 20 &&\n  wordCount >= 4 &&\n  !isGeneric;\n\nreturn [{\n  json: {\n    skipEmbedding: !shouldStore   // BOOLEAN\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        656,
        -112
      ],
      "id": "cfec5d74-544a-4659-992c-489859d6023d",
      "name": "Filter Junk",
      "alwaysOutputData": false
    },
    {
      "parameters": {
        "jsCode": "const choice = $json.choices?.[0];\n\nif (\n  !choice ||\n  choice.error ||\n  !choice.message ||\n  !choice.message.content ||\n  choice.message.content.trim() === \"\"\n) {\n  throw new Error(\"Upstream model failed to generate output\");\n}\n\nreturn $input.all();"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        464,
        160
      ],
      "id": "b42d9fc4-6550-48a3-b8ef-4da8cf2e396a",
      "name": "Error Handling"
    },
    {
      "parameters": {
        "jsCode": "const content = $node[\"Openrouter Chat\"].json.choices[0].message.content?.trim() || \"\";\n\nconst ignorePhrases = [\n  \"hi\",\n  \"hello\",\n  \"ok\",\n  \"okay\",\n  \"thanks\",\n  \"thank you\",\n  \"you're welcome\"\n];\n\nconst wordCount = content.split(/\\s+/).length;\nconst charCount = content.length;\n\nconst isGeneric = ignorePhrases.includes(content.toLowerCase());\n\nconst shouldStore =\n  charCount >= 40 &&\n  wordCount >= 6 &&\n  !isGeneric;\n\nreturn [{\n  json: {\n    skipEmbedding: !shouldStore\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
